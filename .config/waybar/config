{
    // Fixed-width transparent bar, centered on screen (ultrawide); each module
    // group is its own floating pill (styled via .modules-left/center/right).
    "layer": "top",
    "position": "top",
    "height": 34,
    "width": 1000,
    "margin-top": 8,
    "spacing": 0,

    "include": ["~/.config/waybar/modules.json"],

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": [
        "custom/waypaper",
        "custom/keymapp",
        "network",
        "pulseaudio",
        "battery",
        "custom/exit"
    ]
}
